# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# claude code (permissoes locais)
.claude/settings.local.json

# credenciais soltas na pasta do projeto
credencial*.txt
*credencial*
*.key

# dumps de conversa: contem credenciais coladas no chat
docs/conversa-*.md
tools/__pycache__/

# estado de runtime dos vigias (quem foi avisado, degrau da escada, suspensoes)
tools/.vigia_relog.json
